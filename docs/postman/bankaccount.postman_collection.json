    "name": "BIL002 BankAccount API",
    "description": "BIL 002 dönem projesi API kabul testleri. Klasörler sırayla çalıştırılmalıdır (hesapNo/hedefNo/bosNo ortam değişkenleriyle taşınır). [H-xx] etiketli isteklerin başarısız olması bulunan bir hatayı gösterir. Ortamlar: yerel (localhost:8080) ve canlı (https://lab.mykucukkara.com/s/<TOKEN>).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Hesap Açma",
      "item": [
        {
          "name": "API-01 Hesap aç (STANDARD, 1000) -> 201",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201 dönmeli (R-1.6)\", () => pm.response.to.have.status(201));",
                  "const r = pm.response.json();",
                  "pm.environment.set(\"hesapNo\", r.accountNumber);",
                  "pm.test(\"Hesap no 10 hane, ilk hane 0 değil (§2.1)\", () => pm.expect(r.accountNumber).to.match(/^[1-9][0-9]{9}$/));",
                  "pm.test(\"Durum ACTIVE, bakiye 1000\", () => { pm.expect(r.status).to.eql(\"ACTIVE\"); pm.expect(r.balance).to.eql(1000); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/accounts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "accounts"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"ownerName\": \"Postman Kaynak\", \"accountType\": \"STANDARD\", \"initialBalance\": 1000}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
